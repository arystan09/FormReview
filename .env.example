# Local development only. Compose reads this file after copying to .env.
# Local uv commands use defaults; export overrides explicitly if needed.
FORMREVIEW_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=formreview
POSTGRES_USER=formreview
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production additionally requires a unique secret (>=50 chars), explicit hosts,
# a private database password, and HTTPS. Never commit actual credentials.
# Optional local private source root (not served by HTTP):
# FORMREVIEW_PRIVATE_ROOT=/absolute/private/path
# PostgreSQL must use UTF-8. Tests need a dedicated disposable database server.
# Paid mode is disabled in the database by default. No API key belongs in this file.
# Owner may supply FORMREVIEW_OPENAI_API_KEY privately to the worker after authorization.
# Public demo is read-only and must have no key:
FORMREVIEW_PUBLIC_DEMO=0
